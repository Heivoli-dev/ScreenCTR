# ScreenCTR sysmodule — makerom RSF
# Title ID 0004013000A5C702 (unique, not used by any known title).
# Values marked "VERIFY" must be validated on hardware (see docs/STATUS.md).

BasicInfo:
  Title                   : ScrnCTR
  ProductCode             : CTR-P-SCTR
  Logo                    : None

RomFs: {}

TitleInfo:
  Category                : Base          # VERIFY: system module category (high id 00040130)
  UniqueId                : 0xA5C70
  Version                 : 0

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCrypt             : false
  EnableCompress          : true

AccessControlInfo:
  CoreVersion             : 2
  DescVersion             : 2
  ReleaseKernelMajor      : "02"
  ReleaseKernelMinor      : "33"
  UseExtSaveData          : false
  FileSystemAccess:
    - DirectSdmc
  MemoryType              : Base           # BASE region, like Rosalina / HzMod
  SystemMode              : 64MB
  SystemModeExt           : Legacy
  CpuSpeed                : 804MHz
  EnableL2Cache           : true
  CanAccessCore2          : true           # stream thread on core 2 (New 3DS)
  IdealProcessor          : 1
  AffinityMask            : 3
  Priority                : 16
  MaxCpu                  : 0
  HandleTableSize         : 0x200
  DisableDebug            : false
  EnableForceDebug        : false
  CanWriteSharedPage      : false
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: true
  PermitMainFunctionArgument: true
  CanShareDeviceMemory    : true
  RunnableOnSleep         : true
  SpecialMemoryArrange    : true

  IORegisterMapping:
    - 1ec46000-1ec47000                    # HID_PAD (physical buttons, hotkey)
  MemoryMapping:
    - 1f000000-1f600000                    # VRAM (framebuffers + overlay)

  SystemCallAccess:
